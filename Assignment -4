    "import json\n",
    "\n",
    "def word_frequency(text):\n",
    "    for ch in \".,!?:;\":\n",
    "        text = text.replace(ch, \" \")\n",
    "\n",
    "    freq = {}\n",
    "    for word in text.lower().split():\n",
    "        freq[word] = freq.get(word, 0) + 1\n",
    "\n",
    "    return freq\n",
    "\n",
    "ticket = input(\"Ticket: \")\n",
    "print(json.dumps(word_frequency(ticket)))"
   ]
