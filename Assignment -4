    "def second_highest(scores):\n",
    "    highest = None\n",
    "    second = None\n",
    "\n",
    "    for s in scores:\n",
    "        if highest is None or s > highest:\n",
    "            second = highest\n",
    "            highest = s\n",
    "        elif s != highest and (second is None or s > second):\n",
    "            second = s\n",
    "\n",
    "    return second\n",
    "print(second_highest([70, 95, 95, 82, 70, 88]))   \n",
    "print(second_highest([50, 50, 50]))               "
   ]
