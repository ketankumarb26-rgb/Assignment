    "class BankAccount:\n",
    "    def __init__(self, account_holder, balance=0):\n",
    "        if balance < 0:\n",
    "            raise ValueError(\"Starting balance cannot be negative\")\n",
    "        self.account_holder = account_holder\n",
    "        self.balance = balance\n",
    "\n",
    "    def deposit(self, amount):\n",
    "        if amount <= 0:\n",
    "            print(f\"Deposit rejected: amount must be greater than 0 (got {amount:.2f})\")\n",
    "            return False\n",
    "        self.balance += amount\n",
    "        print(f\"Deposited {amount:.2f}. New balance: {self.balance:.2f}\")\n",
    "        return True\n",
    "\n",
    "    def withdraw(self, amount):\n",
    "        if amount <= 0:\n",
    "            print(f\"Withdrawal rejected: amount must be greater than 0 (got {amount:.2f})\")\n",
    "            return False\n",
    "        if amount > self.balance:\n",
    "            print(f\"Withdrawal rejected: insufficient funds \"\n",
    "                  f\"(requested {amount:.2f}, available {self.balance:.2f})\")\n",
    "            return False\n",
    "        self.balance -= amount\n",
    "        print(f\"Withdrew {amount:.2f}. New balance: {self.balance:.2f}\")\n",
    "        return True\n",
    "\n",
    "    def display_balance(self):\n",
    "        print(f\"{self.account_holder}'s balance: {self.balance:.2f}\")\n",
    "\n",
    "\n",
    "account = BankAccount(\"Udith\", 1000)\n",
    "\n",
    "account.deposit(500)      \n",
    "account.withdraw(200)     \n",
    "account.withdraw(2000)    \n",
    "account.deposit(-50)      \n",
    "account.withdraw(0)       \n",
    "account.display_balance()"
   ]
