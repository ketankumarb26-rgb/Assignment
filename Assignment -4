    "def remove_duplicate_emails(emails):\n",
    "    seen = set()\n",
    "    result = []\n",
    "\n",
    "    for email in emails:\n",
    "        key = email.lower()\n",
    "        if key not in seen:\n",
    "            seen.add(key)\n",
    "            result.append(email)\n",
    "\n",
    "    return result\n",
    "emails = [\"Sam@site.com\", \"lee@site.com\", \"sam@site.com\", \"LEE@site.com\", \"ana@site.com\"]\n",
    "print(remove_duplicate_emails(emails))\n"
   ]
