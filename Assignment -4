    "class Employee:\n",
    "    def __init__(self, name, employee_id, monthly_salary):\n",
    "        self.name = name\n",
    "        self.employee_id = employee_id\n",
    "        self.monthly_salary = monthly_salary\n",
    "\n",
    "    def annual_salary(self):\n",
    "        return self.monthly_salary * 12\n",
    "\n",
    "    def apply_raise(self, percent):\n",
    "        self.monthly_salary += self.monthly_salary * percent / 100\n",
    "\n",
    "\n",
    "emp = Employee(\"Bharath\", \"E102\", 30000)\n",
    "\n",
    "print(f\"Annual salary before raise: {emp.annual_salary():.2f}\")\n",
    "emp.apply_raise(10)\n",
    "print(f\"Monthly salary after raise: {emp.monthly_salary:.2f}\")\n",
    "print(f\"Annual salary after raise: {emp.annual_salary():.2f}\")"
   ]
