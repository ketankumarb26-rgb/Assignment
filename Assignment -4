    "def validate_user(name, age, email):\n",
    "    errors = []\n",
    "\n",
    "    if not name or not name.strip():\n",
    "        errors.append(\"Name is required\")\n",
    "\n",
    "    if not isinstance(age, int) or not 18 <= age <= 60:\n",
    "        errors.append(\"Age must be between 18 and 60\")\n",
    "\n",
    "    if (\n",
    "        not isinstance(email, str)\n",
    "        or email.count(\"@\") != 1\n",
    "        or email.startswith(\"@\")\n",
    "        or email.endswith(\"@\")\n",
    "    ):\n",
    "        errors.append(\"Email is invalid\")\n",
    "\n",
    "    return errors\n",
    "print(validate_user(\" \", 53, \"userexample.com\"))\n",
    "\n",
    "\n",
    "print(validate_user(\"Anna\", 51, \"anna@site.com\"))"
   ]
